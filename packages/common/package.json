{
  "name": "@dwnprm/common",
  "version": "1.0.0",
  "type": "module",
  "description": "Tools, configurations and utilities common across all packages in DWNPRM",
  "homepage": "https://github.com/bnonni/dwnprm",
  "bugs": {
    "url": "https://github.com/bnonni/dwnprm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bnonni/dwnprm.git"
  },
  "license": "UNLICENSED",
  "contributors": [
    {
      "name": "Bryan Nonni",
      "url": "https://github.com/bnonni"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "decentralized web node package manager",
    "decentralized package manager",
    "decentralized package registry",
    "package registry",
    "package manager",
    "decentralized",
    "decentralized applications",
    "decentralized identity",
    "decentralized web",
    "dweb node",
    "decentralized web node",
    "dwn protocol",
    "decentralized identifiers",
    "decentralized module imports",
    "decentralized package imports",
    "decentralized package",
    "decentralized packages",
    "decentralized resource locator",
    "decentralized resource locators",
    "decentralized identity foundation",
    "dif",
    "web5",
    "dpm",
    "dpr",
    "dwn",
    "dwnpm",
    "dids",
    "dpks",
    "drls",
    "drl"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build && chmod +x ./dist/cli/dwnpm.js ./dist/cli/create-dpk.js ./dist/cli/init-dpk.js",
    "clean": "rimraf dist coverage tests/compiled",
    "wipe": "rimraf node_modules pnpm-lock.json DATA",
    "test:register-hooks": "echo 'Unimplemented!' && exit 0 && npm run build:tests; node --import ./dist/src/register.js ./tests/compiled/tests/register-hooks.spec.js",
    "build": "npm run build:esm && npm run build:cjs",
    "build:cjs": "rimraf dist/cjs && tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > ./dist/cjs/package.json",
    "build:esm": "rimraf dist dist/types && tsc -p tsconfig.json && chmod +x ./dist/cli/dwnpm.js",
    "build:tests": "rimraf tests/compiled && tsc -p tests/tsconfig.json",
  },
  "dependencies": {
    "@bugsnag/cuid": "^3.1.1",
    "@inquirer/prompts": "^7.0.1",
    "@scure/bip39": "^1.5.4",
    "@tbd54566975/dwn-sdk-js": "^0.5.1",
    "@web5/agent": "^0.8.1",
    "@web5/api": "^0.12.0",
    "@web5/common": "^1.1.0",
    "@web5/credentials": "^1.1.3",
    "@web5/crypto": "^1.0.6",
    "@web5/dids": "^1.2.0",
    "@web5/user-agent": "^0.7.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "did-btc-sdk": "^1.0.0",
    "express": "^4.21.0",
    "fs-extra": "^11.2.0",
    "tar": "^7.4.3",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/chai": "^5.0.1",
    "@types/chai-as-promised": "^8.0.1",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.5.4",
    "@types/npm": "^7.19.3",
    "@types/tar-stream": "^3.1.3",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "c8": "^10.1.2",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "eslint-plugin-mocha": "^10.5.0",
    "globals": "^15.11.0",
    "marked": "^14.1.2",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "node-stdlib-browser": "^1.2.1",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  }
}