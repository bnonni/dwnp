{
  "name": "@dwnp/manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Decentralized Web Node Package Manager (DWNPM)",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "dwnpm": "./dist/cli/dwnpm.js",
    "create-dpk": "./dist/cli/create-dpk.js",
    "init-dpk": "./dist/cli/init-dpk.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "homepage": "https://github.com/bnonni/dwnp/tree/main/packages/manager",
  "bugs": {
    "url": "https://github.com/bnonni/dwnp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bnonni/dwnp.git"
  },
  "license": "UNLICENSED",
  "contributors": [
    {
      "name": "Bryan Nonni",
      "url": "https://github.com/bnonni"
    }
  ],
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "decentralized web node package manager",
    "decentralized package manager",
    "decentralized package registry",
    "package registry",
    "package manager",
    "decentralized",
    "decentralized applications",
    "decentralized identity",
    "decentralized web",
    "dweb node",
    "decentralized web node",
    "dwn protocol",
    "decentralized identifiers",
    "decentralized module imports",
    "decentralized package imports",
    "decentralized package",
    "decentralized packages",
    "decentralized resource locator",
    "decentralized resource locators",
    "decentralized identity foundation",
    "dif",
    "web5",
    "dpm",
    "dpr",
    "dwn",
    "dwnpm",
    "dids",
    "dpks",
    "drls",
    "drl"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build && chmod +x ./dist/cli/dwnpm.js ./dist/cli/create-dpk.js ./dist/cli/init-dpk.js",
    "clean": "rimraf dist coverage tests/compiled",
    "wipe": "rimraf node_modules pnpm-lock.json DATA",
    "create": "npm create dpk",
    "init-dpk": "npx init-dpk",
    "build": "npm run build:esm && npm run build:cjs",
    "build:cjs": "rimraf dist/cjs && tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > ./dist/cjs/package.json",
    "build:esm": "rimraf dist dist/types && tsc -p tsconfig.json && chmod +x ./dist/cli/dwnpm.js",
    "build:tests": "rimraf tests/compiled && tsc -p tests/tsconfig.json",
    "install:cli": "rm -f $HOME/.config/dwnpm/bin/dwnpm && npm run build && ln -s $(pwd)/dist/cli/dwnpm.js $HOME/.config/dwnpm/bin/dwnpm",
    "version:cli": "sh scripts/cli/version.sh"
  },
  "dependencies": {
    "@bugsnag/cuid": "^3.1.1",
    "@inquirer/prompts": "^7.3.1",
    "@scure/bip39": "^1.5.4",
    "@tbd54566975/dwn-sdk-js": "^0.5.2",
    "@web5/agent": "^0.8.1",
    "@web5/api": "^0.12.0",
    "@web5/common": "^1.1.0",
    "@web5/credentials": "^1.1.3",
    "@web5/crypto": "^1.0.6",
    "@web5/dids": "^1.2.0",
    "@web5/user-agent": "^0.7.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "did-btc-sdk": "^1.0.0",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "tar": "^7.4.3",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/chai": "^5.0.1",
    "@types/chai-as-promised": "^8.0.1",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.1",
    "@types/npm": "^7.19.3",
    "@types/tar-stream": "^3.1.3",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.24.0",
    "c8": "^10.1.3",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "eslint-plugin-mocha": "^10.5.0",
    "globals": "^15.11.0",
    "marked": "^15.0.7",
    "mocha": "^11.1.0",
    "mocha-junit-reporter": "^2.2.1",
    "node-stdlib-browser": "^1.3.1",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}